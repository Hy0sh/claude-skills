#!/bin/sh
# Releases what a worktree that left outside wtm keeps holding: its recorded
# index, and the stack, volumes and images that index still names. Bound to
# SessionEnd, which runs after the harness has removed its own worktree.
set -u

command -v wtm >/dev/null 2>&1 || exit 0

# SessionEnd hooks share a 1.5 s budget that a plugin's own `timeout` does not
# raise, and the kill takes the whole process tree: a `compose down` cut there
# leaves stopped containers behind. Detached, the clean outlives the hook.
# Every finding wtm would clean is read from docker, so a stopped engine has
# nothing to say and the sweep is not worth starting one for.
nohup sh -c 'docker info >/dev/null 2>&1 && wtm clean -y' </dev/null >/dev/null 2>&1 &
